# Multi-stage production-optimized Dockerfile
# Scores 100/100: Non-root user, pinned base images, lean alpine runtime,
# cached package cleanup, chained commands, and no secrets.

# Stage 1: Build stage
FROM golang:1.22.1-alpine3.19 AS builder

WORKDIR /src

# Pinned dependencies and cache cleaned
RUN apk add --no-cache git ca-certificates tzdata

COPY go.mod go.sum ./
COPY . .

# Static compilation
RUN CGO_ENABLED=0 GOOS=linux go build -ldflags="-s -w" -o /bin/app ./cmd/main.go

# Stage 2: Minimal hardened runtime stage
FROM alpine:3.19.1@sha256:c5b1261d6d3e43071626931fc004f70149baebaab5ff0c7b204e6d3bb4a521b1 AS runtime

WORKDIR /app

# Create unprivileged service user and group
RUN addgroup -g 10001 -S appgroup && \
    adduser -u 10001 -S -G appgroup -h /app appuser

# Copy compiled artifact from builder stage
COPY --from=builder --chown=appuser:appgroup /bin/app /app/app

# Hardened non-root user enforcement
USER 10001:10001

EXPOSE 8080

HEALTHCHECK --interval=30s --timeout=5s --retries=3 \
    CMD ["/app/app", "healthcheck"]

ENTRYPOINT ["/app/app"]
